# Bridge logs can contain prompts, file paths, source code and account details — never commit them.
logs/
*.jsonl
!test/fixtures/*.jsonl
# Local backups
*.bak
*.bak-*
# Node / Python
node_modules/
__pycache__/
*.pyc
# Benchmark runs (copies of the task made by run scripts)
benchmark/runs/
# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local config that may hold secrets
.env
.env.*
